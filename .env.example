# Generate a random 32-byte Base64 key once and keep it across restarts.
# The server reads environment variables; it does not load this file itself.
DATA_ENCRYPTION_KEY=
# Optional keys for rotating encrypted records within this personal version.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# Local-only, passwordless personal service.
ADDR=127.0.0.1:51873
# Leave blank to derive download links from the local request address.
PUBLIC_BASE_URL=
DB_FILE=data/personal.db
PIKPAK_ROOT_FOLDER=Pikpak2DirectLink

# Optional first PikPak account; normally add accounts through the UI.
PIKPAK_USERNAME=
PIKPAK_PASSWORD=

# Personal database snapshots. Keep encryption keys separately.
BACKUP_DIR=data/backups
BACKUP_INTERVAL=24h
BACKUP_RETENTION=7

PIKPAK_REQUEST_TIMEOUT=20s
RESOLVE_TIMEOUT=12m
POLL_INTERVAL=5s
SHARE_PARSE_TIMEOUT=60s
SHARE_URL_TIMEOUT=60s
SHARE_POLL_INTERVAL=3s

# Initial defaults. Saved UI settings take precedence after first use.
# The effective task timeout also respects the resource-resolution minimum.
RESOLVE_CONCURRENCY=1
QUEUE_TIMEOUT=60s
PARALLEL_QUEUE_TIMEOUT=2m

# PikPak credential monitoring; each probe restores then deletes a test file.
ACCOUNT_HEALTH_CHECK_URL=https://mypikpak.com/s/VOveL7ZI01ViAz9VVKGgSWDlo2
ACCOUNT_HEALTH_CHECK_INTERVAL=6h
ACCOUNT_AUTO_REFRESH_GAP=30m
ACCOUNT_HEALTH_CHECK_TIMEOUT=60s
